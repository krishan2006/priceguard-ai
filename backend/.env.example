# PriceGuard AI — Environment Variables
# Copy this file to .env and fill in your keys

# ─── AI Reasoning ────────────────────────────────────────────
# Google Gemini API (Optional — deterministic fallback works without it)
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API (High-speed Llama 3 reasoning — Optional)
# Get free key: https://console.groq.com
GROQ_API_KEY=

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Product Search ──────────────────────────────────────────
# Custom Product Search API key (Optional — falls back to DummyJSON)
# Example: RapidAPI "Real-Time Product Search" key
PRODUCT_SEARCH_API_KEY=
# RapidAPI host for the product search API (if using RapidAPI)
PRODUCT_SEARCH_API_HOST=real-time-product-search.p.rapidapi.com

# Google Serper API (Optional — falls back to DummyJSON)
# Get free key (100 searches/month): https://serper.dev
SERPER_API_KEY=

# ─── Email Notifications ─────────────────────────────────────
# (Optional — in-app + browser notifications work without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./priceguard.db
